# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# HTTP / Socket.IO 监听端口（默认 3048）
# PORT=3048

# 允许的前端来源（HTTP CORS 与 Socket.IO CORS 共用，逗号分隔；`*` 仅限内网调试）
# 未设置时使用默认值：
#   http://localhost:1420 (Tauri dev/Vite)
#   tauri://localhost (macOS/iOS)  http://tauri.localhost (Windows/Linux)  https://tauri.localhost (Android)
# CLIENT_ORIGINS="http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost"

# 设为 true 后，未携带 token 的 WebSocket 握手将被直接拒绝（接入登录后建议开启）
# WS_STRICT_AUTH=false

# ── 七牛云 Kodo（前端直传：后端签上传凭证，前端 qiniu-js 直传）──
# 密钥对：https://portal.qiniu.com/user/key  |  空间：https://portal.qiniu.com/kodo
# QINIU_ACCESS_KEY=""
# QINIU_SECRET_KEY=""
# 存储空间名（Bucket）
# QINIU_BUCKET=""
# 空间外链域名（含协议，如 https://cdn.example.com；空间概览 → 域名管理）
# QINIU_DOMAIN=""
# 存储区域：z0 华东 / z1 华北 / z2 华南 / na0 北美 / as0 东南亚（默认 z0）
# QINIU_REGION="z0"
# 上传凭证有效期（秒，默认 3600，最小 300）
# QINIU_TOKEN_TTL="3600"

# ── 实时传输层（Rust WebTransport 网关，docs/webtransport-migration-plan.md §13）──
# 实时通道实现：socket（Socket.IO，默认）| wt（Rust WebTransport）
# 灰度/回退的权威开关，同时经 GET /transport/config 下发客户端；改值重启即回退，无需发版
# RT_TRANSPORT=socket
# Rust 传输服务的内网地址（RT_TRANSPORT=wt 时必填）
# TRANSPORT_INTERNAL_URL=http://127.0.0.1:3901
# 下发给客户端的 WT 公网地址（RT_TRANSPORT=wt 时必填；IP 也可以 —— 指纹固定不校验域名）
# WT_PUBLIC_URL=https://example.com:4433/wt
# 内部 API 共享令牌（长随机，与 JWT_SECRET 不同源；与 Rust 的 WT_INTERNAL_TOKEN 一致）
# 未配置时 /internal/* 整体 fail-closed
# WT_INTERNAL_TOKEN=""
# 内部端点来源网段白名单（逗号分隔 CIDR；未配置则不做 IP 校验。
# 生产 compose 网络建议设为容器网段，如 172.16.0.0/12）
# INTERNAL_ALLOWED_CIDRS=""
# ⚠️ RT_TRANSPORT=wt 时 JWT_SECRET 变为必填且 ≥16 字节（Nest 未配置时会随机生成 →
# 与 Rust 验签密钥不同 → 所有连接 auth_failed）
# JWT_SECRET=""
# 最低客户端协议版本（低于它的客户端会收到强制升级提示；与 Rust MIN_CLIENT_PROTO 对齐）
# RT_MIN_CLIENT_PROTO=1
