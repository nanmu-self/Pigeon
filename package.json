{
  "name": "pigeon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n DESKTOP,SERVER,TRANSPORT -c blue,green,magenta \"pnpm dev:desktop\" \"pnpm dev:server\" \"pnpm dev:transport\"",
    "dev:desktop": "pnpm --filter @pigeon/desktop tauri dev",
    "dev:server": "pnpm --filter @pigeon/server start:dev",
    "dev:transport": "cargo run -p transport-server",
    "tauri": "pnpm --filter @pigeon/desktop tauri",
    "build": "pnpm --filter @pigeon/desktop build && pnpm --filter @pigeon/server build",
    "check:types": "pnpm --filter @pigeon/desktop check && pnpm --filter @pigeon/server build",
    "test": "pnpm --filter @pigeon/server test"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
